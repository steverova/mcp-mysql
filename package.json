{
  "name": "mcp-mysql",
  "version": "2.5.0",
  "private": true,
  "description": "MySQL MCP server: multiple connections, cross-platform, two-step confirmed writes",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "mysql-mcp": "bin/mysql-mcp.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "login": "node src/wizard.js",
    "logout": "node src/wizard.js --delete --all",
    "list": "node src/wizard.js --list",
    "use": "node src/wizard.js --use",
    "form": "node src/form.js",
    "doctor": "node src/doctor.js",
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --all",
    "test": "node test/handshake.mjs",
    "test:classify": "node test/classify.mjs",
    "test:store": "node test/store.mjs",
    "test:form": "node test/webform.mjs",
    "test:reload": "node test/reload.mjs",
    "test:opencode": "node test/opencode.mjs",
    "test:live": "node test/live.mjs",
    "test:all": "node test/classify.mjs && node test/handshake.mjs && node test/store.mjs && node test/webform.mjs && node test/reload.mjs && node test/opencode.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "mysql2": "^3.24.6",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20.12"
  }
}
