# --- Conexiones ---------------------------------------------------------
# Lo normal es NO rellenar nada aquí y crear las conexiones con:
#     npm run login            (asistente de terminal)
#     save_connection          (formulario en el navegador, desde OpenCode)
#
# Si rellenas MYSQL_USER, se crea una conexión llamada "env" que manda sobre
# el almacén. Útil para CI o Docker.
MYSQL_USER=
MYSQL_PASSWORD=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_SSL=false

# --- Comportamiento ----------------------------------------------------
# Abrir el formulario de conexiones al arrancar si no hay ninguna guardada
MYSQL_PROMPT_ON_START=true

MYSQL_MAX_ROWS=200
# true = permite escritura (siempre con propose_write + confirm_write)
MYSQL_WRITE_ENABLED=true
# Segundos que vale el token de confirmación
MYSQL_CONFIRM_TTL_SECONDS=300
MYSQL_CONNECT_TIMEOUT_MS=10000
